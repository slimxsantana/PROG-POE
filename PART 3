    // 2.a: Display the sender and recipient of all stored messages
    public static void displayStoredSendersAndRecipients() {
        System.out.println("\n--- Stored Messages Senders & Recipients ---");
        boolean found = false;
        for (int i = 0; i < messageCount; i++) {
            if ("Stored".equalsIgnoreCase(messageFlags[i])) {
                // Assuming System/App behaves as Sender, and values denote receiver destinations
                System.out.println("Sender: System -> Recipient: " + recipients[i]);
                found = true;
            }
        }
        if (!found) System.out.println("No stored messages found.");
    }

    // 2.b: Display the longest stored message
    public static String displayLongestMessage() {
        String longest = "";
        for (int i = 0; i < messageCount; i++) {
            if ("Stored".equalsIgnoreCase(messageFlags[i]) && storedMessages[i] != null) {
                if (storedMessages[i].length() > longest.length()) {
                    longest = storedMessages[i];
                }
            }
        }
        System.out.println("\nLongest Stored Message:\n\"" + longest + "\"");
        return longest;
    }

    // 2.c: Search for a message ID and display the corresponding recipient and message
    public static String searchByMessageID(String id) {
        for (int i = 0; i < messageCount; i++) {
            if (messageIDs[i] != null && messageIDs[i].equals(id)) {
                String msg = (storedMessages[i] != null) ? storedMessages[i] : sentMessages[i];
                if (msg == null) msg = disregardedMessages[i];
                
                System.out.println("\nSystem returns: \"" + msg + "\"");
                return msg;
            }
        }
        System.out.println("Message ID not found.");
        return null;
    }

    // 2.d: Search for all messages stored/sent regarding a particular recipient
    public static void searchByRecipient(String recipient) {
        System.out.println("\nSystem returns matches for " + recipient + ":");
        boolean found = false;
        for (int i = 0; i < messageCount; i++) {
            if (recipients[i] != null && recipients[i].equals(recipient)) {
                String msg = (storedMessages[i] != null) ? storedMessages[i] : sentMessages[i];
                if (msg == null) msg = disregardedMessages[i];
                System.out.println("- " + msg);
                found = true;
            }
        }
        if (!found) System.out.println("No messages found for this recipient.");
    }

    // 2.e: Delete a message using the message hash
    public static boolean deleteMessageByHash(String hash) {
        for (int i = 0; i < messageCount; i++) {
            if (messageHashes[i] != null && messageHashes[i].equalsIgnoreCase(hash)) {
                String TargetMsg = (storedMessages[i] != null) ? storedMessages[i] : sentMessages[i];
                
                // Clear out data from tracking indices
                storedMessages[i] = null;
                sentMessages[i] = null;
                disregardedMessages[i] = null;
                messageHashes[i] = null;
                messageIDs[i] = null;
                recipients[i] = null;
                messageFlags[i] = null;

                System.out.println("Message: \"" + TargetMsg + "\" successfully deleted.");
                return true;
            }
        }
        System.out.println("Hash identity not found.");
        return false;
    }

    // 2.f: Display a report that lists full details of all active records
